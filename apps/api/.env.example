# ----------------------------------------------------------------------------
# NIR API — environment template. Copy to .env and fill in.
# Full explanation of every integration: docs/SETUP.md
# ----------------------------------------------------------------------------
# Port: 5432 = Docker Postgres (docker compose); 5433 = the local Windows install (see docs/SETUP.md)
DATABASE_URL="postgresql://nir_dev:nir_dev_password@localhost:5432/nir_dev?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"   # comma-separated; add e.g. http://<LAN-IP>:3000 to test from other devices
# Number of reverse-proxy hops in front of the API (nginx/Railway/Cloudflare) — needed for
# correct client IPs in rate limiting and CAPTCHA checks. Leave unset if exposed directly.
# TRUST_PROXY=1

# --- CAPTCHA on every login and every OTP send -------------------------------
# turnstile | recaptcha (v2 checkbox) | hcaptcha | none
# Unset = none in dev; unset is a startup ERROR when NODE_ENV=production.
CAPTCHA_PROVIDER="turnstile"
CAPTCHA_SITE_KEY="1x00000000000000000000AA"            # Turnstile test key (always passes)
CAPTCHA_SECRET_KEY="1x0000000000000000000000000000000AA" # Turnstile test secret

# --- Registration OTP ---------------------------------------------------------
OTP_CHANNELS="EMAIL,SMS"          # which verification methods the register page offers
# OTP_SECRET=""                   # HMAC key for stored codes (defaults to JWT_ACCESS_SECRET)
# OTP_TTL_SECONDS=300
# OTP_RESEND_SECONDS=60
# OTP_MAX_SENDS_PER_HOUR=5
# OTP_MAX_ATTEMPTS=5

# --- Email: smtp | console (console = write to API log; unset is a startup ERROR in production)
# a2i Google Workspace account (STARTTLS on 587). Without the app password, switch
# MAIL_TRANSPORT to "console" so codes go to the API log instead.
MAIL_TRANSPORT="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false                 # true for port 465 (implicit TLS)
SMTP_REQUIRE_TLS=true             # with SMTP_SECURE=false: refuse to send unless STARTTLS succeeds
SMTP_USER="support-challenge@a2i.gov.bd"
SMTP_PASS=""                      # Google app password for SMTP_USER: ask the team, never commit it
MAIL_FROM="NIR Platform <support-challenge@a2i.gov.bd>"
MAIL_REPLY_TO="noreply-challenge@a2i.gov.bd"   # optional Reply-To header

# --- SMS: teletalk | http | console (console = write to API log; unset is a startup ERROR in
#     production unless OTP_CHANNELS excludes SMS — set SMS_PROVIDER=console explicitly then)
# Teletalk Bulk SMS (a2i account). Without the password, switch SMS_PROVIDER to "console".
# OTP-class SMS must be <= 70 UTF-8 bytes (a Bangla letter = 3 bytes); see docs/SETUP.md.
SMS_PROVIDER="teletalk"
SMS_TELETALK_USER="challenge"
SMS_TELETALK_USER_ID="102"
SMS_TELETALK_PASSWORD=""          # ask the team, never commit it (sent to Teletalk only as md5)
# SMS_TELETALK_URL="http://bulksms1.teletalk.com.bd:8091/jlinktbls.php"
# SMS_TELETALK_SERVERNAME="bulksms1.teletalk.com.bd"
# SMS_TELETALK_SMS_CLASS="OTP"
# SMS_TELETALK_SMS_ID="44"
# SMS_TELETALK_CHARSET="ASCII|ASCII|UTF-8|ASCII"
# SMS_TELETALK_VALIDITY="1440"
# Generic gateway alternative (SMS_PROVIDER="http"):
# SMS_HTTP_URL="https://gateway.example.com/send?api_key=KEY&to={to}&msg={message}"
# SMS_HTTP_METHOD=GET
# SMS_HTTP_BODY=''                # e.g. {"api_token":"KEY","sid":"SID","msisdn":"{to}","sms":"{message}","csms_id":"{ref}"}
# SMS_HTTP_CONTENT_TYPE=""        # inferred from body: { → application/json, else form-urlencoded
# SMS_HTTP_HEADERS='{"Authorization":"Bearer KEY"}'
# SMS_HTTP_SUCCESS_PATTERN=""     # regex the gateway response must match (default: any 2xx)
