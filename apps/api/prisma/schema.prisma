model ResourceDocument {
  id            String       @id @default(cuid())
  titleEn       String
  titleBn       String?
  type          ResourceType
  descriptionEn String?
  descriptionBn String?
  fileUrl       String
  fileType      String
  fileSizeBytes Int
  publishedAt   DateTime     @default(now())
}

model Challenge {
  id                 String          @id @default(cuid())
  slug               String          @unique
  titleEn            String
  titleBn            String?
  organizingAgency   String
  organizingAgencyBn String?
  categoryId         String?
  descriptionEn      String
  descriptionBn      String?
  status             ChallengeStatus @default(UPCOMING)
  isFeatured         Boolean         @default(false)
  startDate          DateTime?
  deadline           DateTime?
  bannerImageUrl     String?
  prizeInfoEn        String?
  prizeInfoBn        String?
  applyUrl           String?
  // Label of the "submit to this challenge" button (2026-11-16); NULL → the site's default label.
  submitButtonLabelEn String?
  submitButtonLabelBn String?
  // Configurable details-page fields (2026-11-18) — an ordered JSON list, one entry per field the
  // admin defined for this challenge: {key, sectionEn?, sectionBn?, labelEn, labelBn?, type,
  // placeholderEn/Bn?, helpTextEn/Bn?, options?: [{en, bn?}], validation?: {required, minLength,
  // maxLength, min, max, pattern, patternMessageEn/Bn}, value?, valueBn?}. Shape and rules live in
  // @nir/shared (challenge-detail-fields.ts); the API normalizes + validates before saving.
  // Replaced the fixed problemStatement/eligibility/evaluationCriteria/prizeDetails/additionalInfo
  // En/Bn columns, whose content the migration moved into this list.
  detailFields         Json?
  contactName          String?
  contactEmail         String?
  contactPhone         String?
  // JSON lists, validated by the DTOs (see challenges/dto/challenge.dto.ts):
  // timelinePhases [{label, labelBn?, date?: 'YYYY-MM-DD', description?, descriptionBn?}],
  // faqs [{question, questionBn?, answer, answerBn?}], resources [{label, labelBn?, url}]
  // (url: http(s) or /uploads/...). The *Bn keys (2026-11-15) fall back to English when blank.
  timelinePhases       Json?
  faqs                 Json?
  resources            Json?
  // Visibility/submission controls (see PROJECT_CONTEXT.md#business-rules):
  // isPublished — shown on the public portal at all; isActive — the challenge is running (an
  // inactive challenge stays visible but is never featured and never accepts submissions);
  // submissionsEnabled — the admin's per-challenge submission switch. A challenge accepts
  // submissions only when all three are true, status is OPEN, it has a categoryId and at least one
  // form field, and today is inside its startDate/deadline window (see challenge-rules.ts).
  isPublished        Boolean         @default(true)
  isActive           Boolean         @default(true)
  submissionsEnabled Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt

  formFields   ChallengeFormField[]
  innovations  Innovation[]
  bulkMessages BulkMessage[]
}

// One field of a challenge's dynamic submission form (the admin form builder), ordered by
// sortOrder. Editing/deleting fields never affects past submissions — see
// Innovation.challengeResponses.
model ChallengeFormField {
  id                String                  @id @default(cuid())
  challengeId       String
  challenge         Challenge               @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  key               String // stable machine key, unique per challenge, used as the response key
  label             String
  labelBn           String?
  description       String?
  descriptionBn     String?
  type              FormFieldType
  required          Boolean                 @default(false)
  placeholder       String?
  placeholderBn     String?
  helpText          String?
  helpTextBn        String?
  options           String[]                @default([]) // SELECT / RADIO / CHECKBOX choices
  // Bangla display text for `options`, index-aligned ('' = fall back to English). Answers always
  // store the English option, so validation and reviewer views don't depend on the language.
  optionsBn         String[]                @default([])
  acceptedFileTypes String[]                @default([]) // FILE / MULTI_FILE, e.g. [".pdf", ".docx"]
  maxFileSizeMb     Int? // FILE / MULTI_FILE, capped at the upload endpoint's 50 MB
  maxFiles          Int? // MULTI_FILE only
  mapsTo            InnovationFieldMapping?
  // Conditional display (2026-11-17): when set, the field is shown — and validated/stored — only
  // if the earlier choice field with this key has an answer in `showIfValues` (any overlap for a
  // CHECKBOX list). Null = always shown.
  showIfFieldKey    String?
  showIfValues      String[]                @default([])
  sortOrder         Int                     @default(0)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([challengeId, key])
  @@index([challengeId, sortOrder])
}

// Admin-controlled platform switches, one row per key (e.g. "generalSubmissionEnabled").
// Read through SettingsService, which supplies defaults for keys that have no row yet.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model Partner {
  id         String  @id @default(cuid())
  name       String
  logoUrl    String
  websiteUrl String?
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)
}

