// NIR Platform — Prisma schema
// Organized by SRS component (§3). See /Documents/SRS_NIR_Platform with UML.docx for source requirements.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Shared enums (kept in sync with packages/shared/src/enums.ts)
// ============================================================================

enum Role {
  INNOVATION_SUBMITTER
  INSTITUTIONAL_COORDINATOR
  EXPERT_EVALUATOR
  INVESTOR
  STAKEHOLDER_PARTNER
  PLATFORM_ADMIN
  SYSTEM_ADMIN
  PUBLIC_VIEWER
  POLICY_OBSERVER
  INNOVATION_MANAGER
  MINISTRY_FOCAL_POINT
  MENTOR
  PRELIMINARY_REVIEWER
  AUTHENTICITY_REVIEWER
}

enum ReviewStatus {
  DRAFT
  UNDER_REVIEW
  AUTHENTICITY_REVIEW
  SHORTLISTED
  SELECTED
  APPROVED
  REJECTED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum DevelopmentStage {
  IDEA
  PROTOTYPE_DEVELOPED
  PILOT_IMPLEMENTED
  COMMERCIALIZED
  SCALED
  DISCONTINUED
}

enum PipelineStage {
  INTAKE
  UNDER_ASSESSMENT
  ADVISORY_SUPPORT
  FUNDED
  SCALING
  CLOSED
}

enum InnovationType {
  PRODUCT
  PROCESS
  SERVICE
  DIGITAL_SOLUTION
  TECHNOLOGY
  POLICY_INNOVATION
  RESEARCH_OUTPUT
}

enum OrganizationType {
  GOVERNMENT
  UNIVERSITY
  STARTUP
  PRIVATE_SECTOR
  NGO
  RESEARCH_INSTITUTE
  INDIVIDUAL
}

enum FundingSource {
  A2I_INNOVATION_FUND
  GOVERNMENT
  DEVELOPMENT_PARTNER
  PRIVATE_INVESTMENT
  SELF_FUNDED
}

enum IpStatus {
  NONE
  PATENTED
  PATENT_PENDING
  UNDER_PROCESSING
}

enum EvaluationRecommendation {
  REJECT
  SHORTLIST
  FUND
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
}

enum ContentType {
  PAGE
  ANNOUNCEMENT
  BLOG_POST
  FAQ
  NOTIFICATION_TEMPLATE
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

// One-time-passcode delivery channel / purpose (registration verification).
enum OtpChannel {
  EMAIL
  SMS
}

enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
  // An admin confirming a bulk email/SMS send (2026-11-18) — sent to the admin's own email/phone.
  BULK_MESSAGE_CONFIRM
}

enum MessageChannel {
  EMAIL
  SMS
}

enum BulkMessageStatus {
  QUEUED
  SENDING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum BulkRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum EoiStatus {
  SUBMITTED
  ACKNOWLEDGED
  IN_DISCUSSION
  AGREEMENT_SIGNED
  DECLINED
}

enum ChallengeStatus {
  UPCOMING
  OPEN
  CLOSED
  EVALUATING
  COMPLETED
}

// How an innovation entered the platform — the standard /submit form (GENERAL) or a challenge's
// dynamic, admin-configured form (CHALLENGE, always with challengeId set).
enum SubmissionChannel {
  GENERAL
  CHALLENGE
}

// Field types available in the challenge submission form builder (ChallengeFormField.type).
enum FormFieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  EMAIL
  PHONE
  SELECT
  RADIO
  CHECKBOX
  DATE
  FILE
  MULTI_FILE
}

// Optional binding from a challenge form field to a core Innovation column, so a challenge
// submission gets a meaningful title/summary in every existing review queue and listing.
enum InnovationFieldMapping {
  TITLE
  SUMMARY
  PROBLEM_STATEMENT
  PROPOSED_SOLUTION
}

enum SessionMode {
  ONLINE
  IN_PERSON
}

enum SessionStatus {
  PROPOSED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum AttachmentKind {
  PHOTO
  VIDEO
  DOCUMENT
  PUBLICATION
  PATENT
}

enum RegionType {
  DIVISION
  DISTRICT
}

enum TagType {
  THEMATIC
  TECHNOLOGY
}

enum MinistrySubmissionStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  REJECTED
}

enum ResourceType {
  GUIDELINE
  POLICY
  SOP
  MANUAL
  TEMPLATE
  REPORT
  TOOLKIT
}

enum Locale {
  en
  bn
}

// ============================================================================
// Identity, Auth, RBAC, Audit — cross-cutting (SRS §5.2)
// ============================================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  phone           String?   @unique
  passwordHash    String
  roles           Role[]    @default([PUBLIC_VIEWER])
  fullName        String
  locale          Locale    @default(en)
  isActive        Boolean   @default(true)
  rejectedAt      DateTime?
  mfaEnabled      Boolean   @default(false)
  mfaSecret       String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  designation     String?
  institution     String?
  avatarUrl       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  innovatorProfile Innovator?
  investorProfile  Investor?
  mentorProfile    Mentor?
  ministryProfile  MinistryFocalPoint?

  // Expert Evaluator specialization — Innovation Category id(s) this evaluator is categorised under.
  evaluatorCategoryIds            String[] @default([])
  // Preliminary Reviewer specialization — Innovation Category id(s) this reviewer screens.
  preliminaryReviewerCategoryIds  String[] @default([])
  // Authenticity Reviewer specialization — Innovation Category id(s) this reviewer vets for authenticity/originality.
  authenticityReviewerCategoryIds String[] @default([])

  refreshTokens             RefreshToken[]
  auditLogs                 AuditLog[]
  bulkMessagesSent          BulkMessage[]
  notifications             Notification[]
  savedSearches             SavedSearch[]
  feedbackMessages          FeedbackGrievance[]
  authoredContent           ContentItem[]               @relation("ContentAuthor")
  contentRevisions          ContentRevision[]
  uploadedMedia             MediaAsset[]
  evaluationsGiven          Evaluation[]                @relation("EvaluatorUser")
  panelAssignments          EvaluationPanelAssignment[] @relation("AssignedEvaluator")
  assignedBy                EvaluationPanelAssignment[] @relation("AssignedBy")
  ipFlagsRaised             IpAdvisoryFlag[]
  fundDisbursementsRecorded FundDisbursement[]
  pipelineNotes             PipelineNote[]
  teamMemberships           InnovationTeamMember[]
  referralsSent             InnovationReferral[]        @relation("ReferredBy")
  reviewCommentsAuthored    ReviewComment[]

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A one-time passcode sent to an email address or phone number *before* an account exists
// (so no userId). Only an HMAC of the code is stored. A newer code for the same
// target/purpose supersedes older unconsumed ones (they're marked consumed on send).
model OtpCode {
  id         String     @id @default(cuid())
  purpose    OtpPurpose
  channel    OtpChannel
  // Normalized destination: lower-cased email, or E.164 phone (+8801XXXXXXXXX).
  target     String
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  requestIp  String?
  createdAt  DateTime   @default(now())

  @@index([target, purpose, createdAt])
}

// A bulk email/SMS an admin sent to one challenge's participants (2026-11-18, admin "Participants &
// messaging" page). The recipient list is snapshotted into BulkMessageRecipient when the send is
// confirmed; a background worker in BulkMessagesService delivers it in throttled batches.
model BulkMessage {
  id               String            @id @default(cuid())
  channel          MessageChannel
  // SetNull + title snapshot: the history row survives the challenge being deleted.
  challengeId      String?
  challenge        Challenge?        @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  challengeTitleEn String
  subject          String? // EMAIL only
  body             String // as composed, {{placeholders}} unrendered
  // sha256 of channel + subject + body: the "this exact message already went out" guard.
  contentHash      String
  // Generated by the client once per composition; a replayed request returns this row, never a 2nd send.
  requestKey       String            @unique
  status           BulkMessageStatus @default(QUEUED)
  totalRecipients  Int               @default(0)
  sentCount        Int               @default(0)
  failedCount      Int               @default(0)
  skippedCount     Int               @default(0)
  createdById      String
  createdBy        User              @relation(fields: [createdById], references: [id])
  createdAt        DateTime          @default(now())
  startedAt        DateTime?
  completedAt      DateTime?

  recipients BulkMessageRecipient[]

  @@index([challengeId, channel, createdAt])
  @@index([status])
  @@index([createdAt])
}

model BulkMessageRecipient {
  id            String              @id @default(cuid())
  bulkMessageId String
  bulkMessage   BulkMessage         @relation(fields: [bulkMessageId], references: [id], onDelete: Cascade)
  userId        String?
  name          String
  // Normalized email (lower-case) / E.164 phone; for SKIPPED rows whatever was on file (may be '').
  address       String
  locale        String              @default("en")
  status        BulkRecipientStatus @default(PENDING)
  error         String? // why it failed or was skipped (shown in the history detail)
  sentAt        DateTime?

  @@unique([bulkMessageId, userId])
  @@index([bulkMessageId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ============================================================================
// Reference data — admin-managed lookups consumed everywhere (SRS FR-C4.M2.11)
// ============================================================================

model Category {
  id            String  @id @default(cuid())
  slug          String  @unique
  icon          String
  nameEn        String
  nameBn        String
  descriptionEn String
  descriptionBn String?
  examplesEn    String?
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)

  innovations Innovation[]

  @@index([slug])
}

model SdgTag {
  id       String  @id @default(cuid())
  code     Int     @unique // 1-17
  nameEn   String
  nameBn   String
  isActive Boolean @default(true)

  innovations InnovationSdgTag[]
}

model Tag {
  id       String  @id @default(cuid())
  type     TagType
  nameEn   String
  nameBn   String
  isActive Boolean @default(true)

  innovations InnovationTag[]

  @@unique([type, nameEn])
}

model Region {
  id       String     @id @default(cuid())
  type     RegionType
  nameEn   String
  nameBn   String
  parentId String?
  parent   Region?    @relation("RegionHierarchy", fields: [parentId], references: [id])
  children Region[]   @relation("RegionHierarchy")
  isActive Boolean    @default(true)

  innovations   Innovation[]
  organizations Organization[]

  @@index([parentId])
}

model Ministry {
  id       String  @id @default(cuid())
  code     String  @unique
  nameEn   String
  nameBn   String
  isActive Boolean @default(true)

  focalPoints MinistryFocalPoint[]
  submissions MinistrySubmission[]
  innovations Innovation[]
}

// ============================================================================
// Component 1 — Innovation Submission & Evaluation System
// ============================================================================

model Organization {
  id         String           @id @default(cuid())
  name       String
  type       OrganizationType
  websiteUrl String?
  logoUrl    String?
  regionId   String?
  region     Region?          @relation(fields: [regionId], references: [id])
  isVerified Boolean          @default(false)
  createdAt  DateTime         @default(now())

  innovators  Innovator[]
  innovations Innovation[]
}

model Innovator {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  irn            String        @unique // Innovator Recognition Number, e.g. IRN-2026-000123
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  nidVerified    Boolean       @default(false)
  bio            String?
  createdAt      DateTime      @default(now())

  teamMemberships InnovationTeamMember[]
}

model Innovation {
  id                       String           @id @default(cuid())
  innovationCode           String           @unique // e.g. NIR-2026-000123
  slug                     String           @unique
  titleEn                  String
  titleBn                  String?
  summaryEn                String
  summaryBn                String?
  problemStatement         String
  proposedSolution         String
  objectives               String?
  keyFeatures              String?
  targetBeneficiaries      String?
  impact                   String?
  technologyReadinessLevel Int? // 1-9
  innovationType           InnovationType
  developmentStage         DevelopmentStage @default(IDEA)
  ipStatus                 IpStatus         @default(NONE)
  fundingSource            FundingSource?
  commercializationStatus  String?
  replicationPotential     String?
  mentorshipNeeded         Boolean          @default(false)
  fundingNeeded            Boolean          @default(false)
  recognitionNeeded        Boolean          @default(false)

  // Admin's Permission & Approval decision per support type requested above — each pair is only
  // meaningful when its sibling "*Needed" flag is true (the UI only shows what was requested), but
  // left independently settable here since a request can be granted after the fact even if the
  // corresponding "*Needed" flag is later changed. One shared `approvalLetterUrl` covers whichever
  // of the three were approved, rather than a separate upload per type.
  recognitionApproved        Boolean @default(false)
  recognitionApprovalComment String?
  mentorApproved             Boolean @default(false)
  mentorApprovalComment      String?
  fundApproved               Boolean @default(false)
  fundApprovalComment        String?
  approvalLetterUrl          String?

  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  regionId       String?
  region         Region?       @relation(fields: [regionId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  submittedById  String
  // True only for innovations a Platform/System Admin created through the admin "Submit & publish"
  // flow (InnovationsService.create) — the public "Submitted by" card then credits the admin
  // instead of the team's lead innovator. Deliberately a flag rather than "submitter has an admin
  // role": bulk-imported innovations also have the admin as submittedById but must keep crediting
  // their real innovator.
  createdByAdmin Boolean       @default(false)
  latitude       Float?
  longitude      Float?

  ministryId      String?
  ministry        Ministry?                @relation(fields: [ministryId], references: [id])
  ministryCycleId String?
  ministryCycle   MinistrySubmissionCycle? @relation(fields: [ministryCycleId], references: [id])

  reviewStatus             ReviewStatus  @default(DRAFT)
  reviewRemarks            String?
  // Which stage's reviewer rejected this innovation, so each stage's "Rejected" queue can be
  // scoped to rejections it's actually responsible for instead of every REJECTED innovation in
  // its assigned categories. Null unless reviewStatus is currently REJECTED (or was rejected from
  // a stage other than preliminary/authenticity review, e.g. by a coordinator from SHORTLISTED) —
  // recomputed by InnovationsService.updateStatus on every transition, cleared on any transition
  // away from REJECTED.
  rejectedAtStage          ReviewStage?
  // Which specific Authenticity Reviewer shortlisted this innovation (set on the
  // AUTHENTICITY_REVIEW -> SHORTLISTED transition, preserved through later stages like SELECTED/
  // PUBLISHED so the "Reviewed" tab still attributes correctly) — multiple reviewers can share a
  // category, so category alone isn't enough to scope "my reviewed items" to one person. Plain
  // id field (no formal relation), matching submittedById's existing pattern on this model.
  authenticityReviewedById String?
  pipelineStage            PipelineStage @default(INTAKE)
  isFeatured               Boolean       @default(false)
  viewCount                Int           @default(0)
  languageOriginal         Locale        @default(en)

  // Submission channel (see SubmissionChannel). CHALLENGE submissions always carry challengeId and
  // challengeResponses: a snapshot array of {fieldId, key, label, type, value, files?} taken at
  // submission time, so later edits to the challenge's form never alter what was submitted.
  submissionChannel  SubmissionChannel @default(GENERAL)
  challengeId        String?
  challenge          Challenge?        @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  challengeResponses Json?

  submittedAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team                  InnovationTeamMember[]
  attachments           InnovationAttachment[]
  tags                  InnovationTag[]
  sdgTags               InnovationSdgTag[]
  evaluations           Evaluation[]
  panelAssignments      EvaluationPanelAssignment[]
  ipFlags               IpAdvisoryFlag[]
  successStory          SuccessStory?
  awards                Award[]
  expressionsOfInterest ExpressionOfInterest[]
  fundingAgreements     FundingAgreement[]
  fundDisbursements     FundDisbursement[]
  mentorMatches         MentorMatch[]
  pipelineNotes         PipelineNote[]
  referrals             InnovationReferral[]
  reviewComments        ReviewComment[]

  @@index([categoryId])
  @@index([reviewStatus])
  @@index([developmentStage])
  @@index([regionId])
  @@index([ministryId])
  @@index([slug])
  @@index([challengeId])
  @@index([submissionChannel])
}

model InnovationTeamMember {
  id           String     @id @default(cuid())
  innovationId String
  innovation   Innovation @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  innovatorId  String?
  innovator    Innovator? @relation(fields: [innovatorId], references: [id])
  userId       String?
  user         User?      @relation(fields: [userId], references: [id])
  displayName  String
  roleInTeam   String     @default("Team Member")

  @@index([innovationId])
}

model InnovationAttachment {
  id           String         @id @default(cuid())
  innovationId String
  innovation   Innovation     @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  kind         AttachmentKind
  url          String
  caption      String?
  mimeType     String?
  sizeBytes    Int?
  createdAt    DateTime       @default(now())

  @@index([innovationId])
}

model InnovationTag {
  innovationId String
  innovation   Innovation @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  tagId        String
  tag          Tag        @relation(fields: [tagId], references: [id])

  @@id([innovationId, tagId])
}

model InnovationSdgTag {
  innovationId String
  innovation   Innovation @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  sdgTagId     String
  sdgTag       SdgTag     @relation(fields: [sdgTagId], references: [id])

  @@id([innovationId, sdgTagId])
}

model SuccessStory {
  id           String        @id @default(cuid())
  innovationId String        @unique
  innovation   Innovation    @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  titleEn      String
  titleBn      String?
  bodyEn       String
  bodyBn       String?
  status       ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
}

model Award {
  id           String     @id @default(cuid())
  innovationId String
  innovation   Innovation @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  title        String
  grantedBy    String?
  year         Int?
}

model EvaluationPanelAssignment {
  id                String     @id @default(cuid())
  innovationId      String
  innovation        Innovation @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  evaluatorId       String
  evaluator         User       @relation("AssignedEvaluator", fields: [evaluatorId], references: [id])
  assignedById      String
  assignedBy        User       @relation("AssignedBy", fields: [assignedById], references: [id])
  expertDomainTagId String?
  createdAt         DateTime   @default(now())

  @@unique([innovationId, evaluatorId])
}

model Evaluation {
  id             String                    @id @default(cuid())
  innovationId   String
  innovation     Innovation                @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  evaluatorId    String
  evaluator      User                      @relation("EvaluatorUser", fields: [evaluatorId], references: [id])
  scores         Json // rubric: { criterion: score }
  totalScore     Float?
  comments       String?
  recommendation EvaluationRecommendation?
  isBlind        Boolean                   @default(false)
  submittedAt    DateTime?
  createdAt      DateTime                  @default(now())

  @@unique([innovationId, evaluatorId])
}

model IpAdvisoryFlag {
  id           String     @id @default(cuid())
  innovationId String
  innovation   Innovation @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  flaggedById  String
  flaggedBy    User       @relation(fields: [flaggedById], references: [id])
  note         String?
  createdAt    DateTime   @default(now())
}

enum ReviewStage {
  PRELIMINARY_REVIEW
  AUTHENTICITY_REVIEW
}

// Full history of comments left by Preliminary Reviewers and Authenticity Reviewers as an
// innovation moves through the pipeline — kept separate from Innovation.reviewRemarks (which
// only ever holds the single latest note) so each stage's comments stay visible downstream,
// including across reject/resubmit loops.
model ReviewComment {
  id           String      @id @default(cuid())
  innovationId String
  innovation   Innovation  @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  authorId     String
  author       User        @relation(fields: [authorId], references: [id])
  stage        ReviewStage
  note         String
  createdAt    DateTime    @default(now())

  @@index([innovationId])
}

// ============================================================================
// Component 2 — Innovation Funding Matchmaking
// ============================================================================

model Investor {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName  String
  binNumber         String?  @unique
  binVerified       Boolean  @default(false)
  sectorInterestIds String[] // Category ids of interest
  createdAt         DateTime @default(now())

  expressionsOfInterest ExpressionOfInterest[]
  fundingAgreements     FundingAgreement[]
  referrals             InnovationReferral[]
}

model ExpressionOfInterest {
  id           String     @id @default(cuid())
  innovationId String
  innovation   Innovation @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  investorId   String
  investor     Investor   @relation(fields: [investorId], references: [id], onDelete: Cascade)
  message      String?
  status       EoiStatus  @default(SUBMITTED)
  createdAt    DateTime   @default(now())

  @@index([innovationId])
  @@index([investorId])
}

model InnovationReferral {
  id           String     @id @default(cuid())
  innovationId String
  innovation   Innovation @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  investorId   String
  investor     Investor   @relation(fields: [investorId], references: [id], onDelete: Cascade)
  referredById String
  referredBy   User       @relation("ReferredBy", fields: [referredById], references: [id])
  message      String?
  createdAt    DateTime   @default(now())

  @@unique([innovationId, investorId])
  @@index([innovationId])
  @@index([investorId])
}

model FundingAgreement {
  id           String     @id @default(cuid())
  innovationId String
  innovation   Innovation @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  investorId   String?
  investor     Investor?  @relation(fields: [investorId], references: [id])
  title        String
  documentUrl  String
  signedDate   DateTime?
  createdAt    DateTime   @default(now())
}

model FundDisbursement {
  id           String        @id @default(cuid())
  innovationId String
  innovation   Innovation    @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(14, 2)
  currency     String        @default("BDT")
  source       FundingSource
  disbursedAt  DateTime
  note         String?
  recordedById String
  recordedBy   User          @relation(fields: [recordedById], references: [id])
  createdAt    DateTime      @default(now())

  @@index([innovationId])
}

// ============================================================================
// Component 3 — Repository & Knowledge Management (search handled in service layer)
// ============================================================================

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  queryJson Json
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================================
// Component 4 — Communication & Stakeholder Engagement (incl. CMS, FR-C4.M2)
// ============================================================================

model ContentItem {
  id             String        @id @default(cuid())
  type           ContentType
  slug           String        @unique
  titleEn        String
  titleBn        String?
  bodyEn         String?
  bodyBn         String?
  status         ContentStatus @default(DRAFT)
  authorId       String
  author         User          @relation("ContentAuthor", fields: [authorId], references: [id])
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  revisions ContentRevision[]

  @@index([type, status])
}

