# Copy to .env and adjust before running `docker compose up`.

POSTGRES_USER=nir
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nir

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Origin the browser will use to reach the API (must match how you access the site)
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Where the web container proxies /uploads/* (server-side, build-time). Keep it on the Docker
# network — pointing it at a public URL behind Cloudflare loops and breaks every image.
API_INTERNAL_URL=http://api:4000
