# Copy to .env and adjust before running `docker compose up`.

POSTGRES_USER=nir
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nir

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Origin the browser will use to reach the API (must match how you access the site)
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Where the web container proxies /uploads/* (server-side, build-time). Keep it on the Docker
# network — pointing it at a public URL behind Cloudflare loops and breaks every image.
API_INTERNAL_URL=http://api:4000

# Proxy hops in front of the API (e.g. 1 for nginx, 2 for Cloudflare → nginx). Needed for correct
# client IPs in rate limiting and CAPTCHA checks.
TRUST_PROXY=

# --- Login CAPTCHA + registration OTP (docs/SETUP.md § Registration OTP & login CAPTCHA) ---
# These three MUST be set — the API refuses to start in production if any is blank.
# CAPTCHA_PROVIDER: turnstile | recaptcha | hcaptcha | none
CAPTCHA_PROVIDER=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
# MAIL_TRANSPORT: smtp | console   (console = codes only written to the API log)
MAIL_TRANSPORT=
MAIL_FROM=NIR Platform <no-reply@example.gov.bd>
# Optional Reply-To header on every outgoing email
MAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Refuse to send unless a SMTP_SECURE=false connection upgrades via STARTTLS (default true)
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
# SMS_PROVIDER: teletalk | http | console   (set console if OTP_CHANNELS=EMAIL)
SMS_PROVIDER=
# teletalk = Teletalk Bulk SMS (the a2i account). Password is sent only as md5; never commit it.
SMS_TELETALK_USER=
SMS_TELETALK_USER_ID=
SMS_TELETALK_PASSWORD=
# Optional overrides (defaults = Teletalk's sample): SMS_TELETALK_URL, SMS_TELETALK_SERVERNAME,
# SMS_TELETALK_SMS_CLASS (OTP), SMS_TELETALK_SMS_ID (44), SMS_TELETALK_CHARSET, SMS_TELETALK_VALIDITY
# http = generic template-driven gateway (see docs/SETUP.md)
SMS_HTTP_URL=
SMS_HTTP_BODY=
SMS_HTTP_HEADERS=
SMS_HTTP_SUCCESS_PATTERN=
OTP_CHANNELS=EMAIL,SMS
